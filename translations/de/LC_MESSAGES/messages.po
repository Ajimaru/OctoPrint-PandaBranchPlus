#: octoprint_pandabranchplus/templates/pandabranchplus_tab.jinja2:89
msgid "Ignore"
msgstr "Ignorieren"

#: build/lib/octoprint_pandabranchplus/templates/pandabranchplus_tab.jinja2:61
#: octoprint_pandabranchplus/templates/pandabranchplus_tab.jinja2:61
msgid "Preparing"
msgstr "Vorbereiten"

#: build/lib/octoprint_pandabranchplus/templates/pandabranchplus_tab.jinja2:69
#: octoprint_pandabranchplus/templates/pandabranchplus_tab.jinja2:69
msgid "Printing"
msgstr "Drucken"

#: build/lib/octoprint_pandabranchplus/templates/pandabranchplus_tab.jinja2:77
#: octoprint_pandabranchplus/templates/pandabranchplus_tab.jinja2:77
msgid "Paused"
msgstr "Pausiert"

#: build/lib/octoprint_pandabranchplus/templates/pandabranchplus_tab.jinja2:85
#: octoprint_pandabranchplus/templates/pandabranchplus_tab.jinja2:85
msgid "Error"
msgstr "Fehler"

#: build/lib/octoprint_pandabranchplus/templates/pandabranchplus_tab.jinja2:93
#: octoprint_pandabranchplus/templates/pandabranchplus_tab.jinja2:93
msgid ""
"What the channel falls back to when OctoPrint shuts down. Hold keeps the "
"current state."
msgstr ""
