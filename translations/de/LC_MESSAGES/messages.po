#: octoprint_pandabranchplus/static/js/pandabranchplus.js:200
msgid "Switching failed"
msgstr "Schalten fehlgeschlagen"

#: build/lib/octoprint_pandabranchplus/static/js/pandabranchplus.js:213
#: octoprint_pandabranchplus/static/js/pandabranchplus.js:213
msgid "Switch on 24V channel?"
msgstr "24V-Kanal einschalten?"

#: build/lib/octoprint_pandabranchplus/static/js/pandabranchplus.js:215
#: octoprint_pandabranchplus/static/js/pandabranchplus.js:215
#, python-format
msgid ""
"This switches on \"%(label)s\" (%(type)s). Make sure the connected device is"
" safe to power."
msgstr ""
"Dies schaltet „%(label)s\" (%(type)s) ein. Stelle sicher, dass das "
"angeschlossene Gerät gefahrlos eingeschaltet werden kann."

#: build/lib/octoprint_pandabranchplus/static/js/pandabranchplus.js:220
#: build/lib/octoprint_pandabranchplus/templates/pandabranchplus_tab.jinja2:45
#: octoprint_pandabranchplus/static/js/pandabranchplus.js:220
#: octoprint_pandabranchplus/templates/pandabranchplus_tab.jinja2:45
msgid "Switch on"
msgstr "Einschalten"

#: build/lib/octoprint_pandabranchplus/static/js/pandabranchplus.js:245
#: octoprint_pandabranchplus/static/js/pandabranchplus.js:245
#, python-format
msgid "Panda found — %(count)d channels."
msgstr "Panda gefunden — %(count)d Kanäle."

#: build/lib/octoprint_pandabranchplus/static/js/pandabranchplus.js:252
#: octoprint_pandabranchplus/static/js/pandabranchplus.js:252
msgid "Please enter a host / IP first."
msgstr "Bitte zuerst Host / IP eingeben."

#: build/lib/octoprint_pandabranchplus/static/js/pandabranchplus.js:253
#: octoprint_pandabranchplus/static/js/pandabranchplus.js:253
msgid "Timeout — host did not answer."
msgstr "Timeout — Host hat nicht geantwortet."

#: build/lib/octoprint_pandabranchplus/static/js/pandabranchplus.js:254
#: octoprint_pandabranchplus/static/js/pandabranchplus.js:254
msgid "Panda not reachable at this address."
msgstr "Panda unter dieser Adresse nicht erreichbar."

#: build/lib/octoprint_pandabranchplus/static/js/pandabranchplus.js:266
#: octoprint_pandabranchplus/static/js/pandabranchplus.js:266
msgid "Test failed — see the OctoPrint log."
msgstr "Test fehlgeschlagen — siehe OctoPrint-Log."

#: build/lib/octoprint_pandabranchplus/templates/pandabranchplus_settings.jinja2:6
#: octoprint_pandabranchplus/templates/pandabranchplus_settings.jinja2:6
msgid "Connection"
msgstr "Verbindung"

#: build/lib/octoprint_pandabranchplus/templates/pandabranchplus_settings.jinja2:8
#: octoprint_pandabranchplus/templates/pandabranchplus_settings.jinja2:8
msgid "Panda host / IP"
msgstr "Panda-Host / IP"

#: build/lib/octoprint_pandabranchplus/templates/pandabranchplus_settings.jinja2:13
#: build/lib/octoprint_pandabranchplus/templates/pandabranchplus_settings.jinja2:15
#: octoprint_pandabranchplus/templates/pandabranchplus_settings.jinja2:13
#: octoprint_pandabranchplus/templates/pandabranchplus_settings.jinja2:15
msgid ""
"The IP or hostname of the Panda Branch Plus itself (not the printer). Enter "
"it manually — there is no auto-detect."
msgstr ""
"IP oder Hostname des Panda Branch Plus selbst (nicht des Druckers). Manuell "
"eintragen — es gibt keine automatische Erkennung."

#: build/lib/octoprint_pandabranchplus/templates/pandabranchplus_settings.jinja2:19
#: octoprint_pandabranchplus/templates/pandabranchplus_settings.jinja2:19
msgid "WebSocket port / path"
msgstr "WebSocket-Port / -Pfad"

#: build/lib/octoprint_pandabranchplus/templates/pandabranchplus_settings.jinja2:27
#: octoprint_pandabranchplus/templates/pandabranchplus_settings.jinja2:27
msgid "Advanced — only if firmware differs."
msgstr "Fortgeschritten — nur falls die Firmware abweicht."

#: build/lib/octoprint_pandabranchplus/templates/pandabranchplus_settings.jinja2:31
#: octoprint_pandabranchplus/templates/pandabranchplus_settings.jinja2:31
msgid "Reconnect delay (min / max)"
msgstr "Reconnect-Verzögerung (min / max)"

#: build/lib/octoprint_pandabranchplus/templates/pandabranchplus_settings.jinja2:41
#: build/lib/octoprint_pandabranchplus/templates/pandabranchplus_settings.jinja2:105
#: octoprint_pandabranchplus/templates/pandabranchplus_settings.jinja2:41
#: octoprint_pandabranchplus/templates/pandabranchplus_settings.jinja2:105
msgid "seconds"
msgstr "Sekunden"

#: build/lib/octoprint_pandabranchplus/templates/pandabranchplus_settings.jinja2:43
#: octoprint_pandabranchplus/templates/pandabranchplus_settings.jinja2:43
msgid ""
"Backoff window between reconnect attempts when the Panda is unreachable. The"
" delay doubles from min to max."
msgstr ""
"Wartefenster zwischen Reconnect-Versuchen, wenn der Panda nicht erreichbar "
"ist. Die Verzögerung verdoppelt sich von min bis max."

#: build/lib/octoprint_pandabranchplus/templates/pandabranchplus_settings.jinja2:54
#: octoprint_pandabranchplus/templates/pandabranchplus_settings.jinja2:54
msgid "Test connection"
msgstr "Verbindung testen"

#: build/lib/octoprint_pandabranchplus/templates/pandabranchplus_settings.jinja2:59
#: octoprint_pandabranchplus/templates/pandabranchplus_settings.jinja2:59
msgid "Automation"
msgstr "Automatik"

#: build/lib/octoprint_pandabranchplus/templates/pandabranchplus_settings.jinja2:65
#: octoprint_pandabranchplus/templates/pandabranchplus_settings.jinja2:65
msgid "Automation enabled"
msgstr "Automatik aktiviert"

#: build/lib/octoprint_pandabranchplus/templates/pandabranchplus_settings.jinja2:67
#: octoprint_pandabranchplus/templates/pandabranchplus_settings.jinja2:67
msgid ""
"Master switch. When off, no rule ever switches a channel — manual control "
"keeps working."
msgstr ""
"Hauptschalter. Wenn aus, schaltet keine Regel jemals einen Kanal — manuelles"
" Schalten funktioniert weiter."

#: build/lib/octoprint_pandabranchplus/templates/pandabranchplus_settings.jinja2:72
#: octoprint_pandabranchplus/templates/pandabranchplus_settings.jinja2:72
msgid "Combine state and temperature rule"
msgstr "Zustands- und Temperaturregel kombinieren"

#: build/lib/octoprint_pandabranchplus/templates/pandabranchplus_settings.jinja2:76
#: octoprint_pandabranchplus/templates/pandabranchplus_settings.jinja2:76
msgid "Temperature rule overrides the matrix"
msgstr "Temperaturregel übersteuert die Matrix"

#: build/lib/octoprint_pandabranchplus/templates/pandabranchplus_settings.jinja2:77
#: octoprint_pandabranchplus/templates/pandabranchplus_settings.jinja2:77
msgid "Both must say on (AND)"
msgstr "Beide müssen „an\" sagen (UND)"

#: build/lib/octoprint_pandabranchplus/templates/pandabranchplus_settings.jinja2:78
#: octoprint_pandabranchplus/templates/pandabranchplus_settings.jinja2:78
msgid "Either may say on (OR)"
msgstr "Eine von beiden genügt (ODER)"

#: build/lib/octoprint_pandabranchplus/templates/pandabranchplus_settings.jinja2:81
#: octoprint_pandabranchplus/templates/pandabranchplus_settings.jinja2:81
msgid ""
"What happens when a channel has both a state rule and a temperature rule. "
"Override: while the temperature rule is active it wins; otherwise the matrix"
" decides."
msgstr ""
"Was passiert, wenn ein Kanal sowohl eine Zustands- als auch eine "
"Temperaturregel hat. Übersteuern: solange die Temperaturregel aktiv ist, "
"gewinnt sie; sonst entscheidet die Matrix."

#: build/lib/octoprint_pandabranchplus/templates/pandabranchplus_settings.jinja2:85
#: octoprint_pandabranchplus/templates/pandabranchplus_settings.jinja2:85
msgid "Temperature hysteresis"
msgstr "Temperatur-Hysterese"

#: build/lib/octoprint_pandabranchplus/templates/pandabranchplus_settings.jinja2:94
#: octoprint_pandabranchplus/templates/pandabranchplus_settings.jinja2:94
msgid ""
"Dead band below the threshold before a temperature rule releases — prevents "
"rapid on/off flapping around the threshold."
msgstr ""
"Totband unterhalb der Schwelle, bevor eine Temperaturregel wieder loslässt —"
" verhindert schnelles An/Aus-Flattern um die Schwelle."

#: build/lib/octoprint_pandabranchplus/templates/pandabranchplus_settings.jinja2:98
#: octoprint_pandabranchplus/templates/pandabranchplus_settings.jinja2:98
msgid "Minimum switch interval"
msgstr "Minimales Schaltintervall"

#: build/lib/octoprint_pandabranchplus/templates/pandabranchplus_settings.jinja2:107
#: octoprint_pandabranchplus/templates/pandabranchplus_settings.jinja2:107
msgid ""
"Rate limit per channel: automation will not switch the same channel again "
"within this interval."
msgstr ""
"Ratenbegrenzung pro Kanal: Die Automatik schaltet denselben Kanal innerhalb "
"dieses Intervalls nicht erneut."

#: build/lib/octoprint_pandabranchplus/templates/pandabranchplus_settings.jinja2:110
#: octoprint_pandabranchplus/templates/pandabranchplus_settings.jinja2:110
msgid "Safety"
msgstr "Sicherheit"

#: build/lib/octoprint_pandabranchplus/templates/pandabranchplus_settings.jinja2:116
#: octoprint_pandabranchplus/templates/pandabranchplus_settings.jinja2:116
msgid "Confirm before manually switching on 24V channels"
msgstr "Vor dem manuellen Einschalten von 24V-Kanälen nachfragen"

#: build/lib/octoprint_pandabranchplus/templates/pandabranchplus_settings.jinja2:118
#: octoprint_pandabranchplus/templates/pandabranchplus_settings.jinja2:118
msgid ""
"Shows a confirmation dialog before a manual switch-on of an MX3.0 24V "
"channel — that is where heaters and pumps live."
msgstr ""
"Zeigt eine Bestätigung vor dem manuellen Einschalten eines MX3.0-24V-Kanals "
"— dort hängen Heizungen und Pumpen."

#: build/lib/octoprint_pandabranchplus/templates/pandabranchplus_settings.jinja2:123
#: octoprint_pandabranchplus/templates/pandabranchplus_settings.jinja2:123
msgid "On plugin startup"
msgstr "Beim Plugin-Start"

#: build/lib/octoprint_pandabranchplus/templates/pandabranchplus_settings.jinja2:127
#: octoprint_pandabranchplus/templates/pandabranchplus_settings.jinja2:127
msgid "Apply rules (leave manual channels alone)"
msgstr "Regeln anwenden (manuelle Kanäle nicht anfassen)"

#: build/lib/octoprint_pandabranchplus/templates/pandabranchplus_settings.jinja2:128
#: octoprint_pandabranchplus/templates/pandabranchplus_settings.jinja2:128
msgid "Switch everything off first, then apply rules"
msgstr "Erst alles ausschalten, dann Regeln anwenden"

#: build/lib/octoprint_pandabranchplus/templates/pandabranchplus_settings.jinja2:129
#: octoprint_pandabranchplus/templates/pandabranchplus_settings.jinja2:129
msgid "Restore manual channels, then apply rules"
msgstr "Manuelle Kanäle wiederherstellen, dann Regeln anwenden"

#: build/lib/octoprint_pandabranchplus/templates/pandabranchplus_settings.jinja2:132
#: octoprint_pandabranchplus/templates/pandabranchplus_settings.jinja2:132
msgid ""
"What happens to the channels when the plugin first connects to the Panda "
"after OctoPrint starts."
msgstr ""
"Was mit den Kanälen passiert, wenn sich das Plugin nach dem OctoPrint-Start "
"zum ersten Mal mit dem Panda verbindet."

#: build/lib/octoprint_pandabranchplus/templates/pandabranchplus_settings.jinja2:135
#: octoprint_pandabranchplus/templates/pandabranchplus_settings.jinja2:135
msgid "Diagnostics"
msgstr "Diagnose"

#: build/lib/octoprint_pandabranchplus/templates/pandabranchplus_settings.jinja2:141
#: octoprint_pandabranchplus/templates/pandabranchplus_settings.jinja2:141
msgid "Debug logging"
msgstr "Debug-Protokollierung"

#: build/lib/octoprint_pandabranchplus/templates/pandabranchplus_settings.jinja2:143
#: octoprint_pandabranchplus/templates/pandabranchplus_settings.jinja2:143
msgid ""
"Verbose plugin log (rule evaluations, reconnects). Find it under Settings → "
"Logging → octoprint.plugins.pandabranchplus."
msgstr ""
"Ausführliches Plugin-Log (Regelauswertungen, Reconnects). Zu finden unter "
"Einstellungen → Logging → octoprint.plugins.pandabranchplus."

#: build/lib/octoprint_pandabranchplus/templates/pandabranchplus_settings.jinja2:148
#: octoprint_pandabranchplus/templates/pandabranchplus_settings.jinja2:148
msgid "Log raw WebSocket frames"
msgstr "Rohe WebSocket-Frames protokollieren"

#: build/lib/octoprint_pandabranchplus/templates/pandabranchplus_settings.jinja2:150
#: octoprint_pandabranchplus/templates/pandabranchplus_settings.jinja2:150
msgid ""
"Logs every frame exchanged with the Panda at debug level. Only for protocol "
"diagnostics — noisy."
msgstr ""
"Protokolliert jeden mit dem Panda ausgetauschten Frame auf Debug-Level. Nur "
"für Protokoll-Diagnose — sehr gesprächig."

#: build/lib/octoprint_pandabranchplus/templates/pandabranchplus_tab.jinja2:7
#: octoprint_pandabranchplus/templates/pandabranchplus_tab.jinja2:7
msgid "Panda Branch Plus"
msgstr "Panda Branch Plus"

#: build/lib/octoprint_pandabranchplus/templates/pandabranchplus_tab.jinja2:9
#: octoprint_pandabranchplus/templates/pandabranchplus_tab.jinja2:9
msgid ""
"Assign a function to each of the 10 power channels and automate them based "
"on the printer state."
msgstr ""
"Belege jeden der 10 Stromkanäle mit einer Funktion und automatisiere sie "
"anhand des Druckerzustands."

#: build/lib/octoprint_pandabranchplus/templates/pandabranchplus_tab.jinja2:14
#: octoprint_pandabranchplus/templates/pandabranchplus_tab.jinja2:14
msgid "Panda disconnected — channels are holding their last state."
msgstr "Panda getrennt — die Kanäle behalten ihren letzten Zustand."

#: build/lib/octoprint_pandabranchplus/templates/pandabranchplus_tab.jinja2:23
#: octoprint_pandabranchplus/templates/pandabranchplus_tab.jinja2:23
msgid "Name this channel after what is plugged into it. Saved automatically."
msgstr ""
"Benenne den Kanal nach dem, was angeschlossen ist. Wird automatisch "
"gespeichert."

#: build/lib/octoprint_pandabranchplus/templates/pandabranchplus_tab.jinja2:26
#: octoprint_pandabranchplus/templates/pandabranchplus_tab.jinja2:26
msgid "ON"
msgstr "AN"

#: build/lib/octoprint_pandabranchplus/templates/pandabranchplus_tab.jinja2:26
#: octoprint_pandabranchplus/templates/pandabranchplus_tab.jinja2:26
msgid "OFF"
msgstr "AUS"

#: build/lib/octoprint_pandabranchplus/templates/pandabranchplus_tab.jinja2:31
#: octoprint_pandabranchplus/templates/pandabranchplus_tab.jinja2:31
msgid "Automation: the channel follows the state matrix below."
msgstr "Automatik: Der Kanal folgt der Zustands-Matrix unten."

#: build/lib/octoprint_pandabranchplus/templates/pandabranchplus_tab.jinja2:33
#: octoprint_pandabranchplus/templates/pandabranchplus_tab.jinja2:33
msgid "Auto"
msgstr "Auto"

#: build/lib/octoprint_pandabranchplus/templates/pandabranchplus_tab.jinja2:37
#: octoprint_pandabranchplus/templates/pandabranchplus_tab.jinja2:37
msgid ""
"Manual: you switch the channel yourself, automation keeps its hands off."
msgstr ""
"Manuell: Du schaltest den Kanal selbst, die Automatik fasst ihn nicht an."

#: build/lib/octoprint_pandabranchplus/templates/pandabranchplus_tab.jinja2:39
#: octoprint_pandabranchplus/templates/pandabranchplus_tab.jinja2:39
msgid "Manual"
msgstr "Manuell"

#: build/lib/octoprint_pandabranchplus/templates/pandabranchplus_tab.jinja2:44
#: octoprint_pandabranchplus/templates/pandabranchplus_tab.jinja2:44
msgid "Switch the channel now. In auto mode the rules may switch it back."
msgstr ""
"Kanal jetzt schalten. Im Auto-Modus können die Regeln ihn zurückschalten."

#: build/lib/octoprint_pandabranchplus/templates/pandabranchplus_tab.jinja2:45
#: octoprint_pandabranchplus/templates/pandabranchplus_tab.jinja2:45
msgid "Switch off"
msgstr "Ausschalten"

#: build/lib/octoprint_pandabranchplus/templates/pandabranchplus_tab.jinja2:51
#: octoprint_pandabranchplus/templates/pandabranchplus_tab.jinja2:51
msgid ""
"For each printer state: switch the channel on, off, or leave it as it is "
"(ignore)."
msgstr ""
"Pro Druckerzustand: Kanal einschalten, ausschalten oder so lassen, wie er "
"ist (ignorieren)."

#: build/lib/octoprint_pandabranchplus/templates/pandabranchplus_tab.jinja2:53
#: octoprint_pandabranchplus/templates/pandabranchplus_tab.jinja2:53
